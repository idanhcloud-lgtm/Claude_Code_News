{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run render)",
      "Bash(npm run render:*)",
      "Bash(npm run still)",
      "Bash(npm run lint)",
      "Bash(npx remotion studio:*)",
      "Bash(npx remotion render:*)",
      "Bash(npx remotion still:*)",
      "Bash(npx remotion compositions:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)"
    ]
  }
}
